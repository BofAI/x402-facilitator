{
  "name": "x402-facilitator",
  "version": "2.3.1",
  "description": "x402 Facilitator service (TypeScript, @bankofai/x402-* ecosystem)",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "SPONSORING_REQUIRE_POSTGRES=1 vitest run test/sponsoring-postgres.test.ts test/sponsoring-service-postgres.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:gateway": "npm run build && node --test test/gateway-integration.mjs"
  },
  "dependencies": {
    "@1password/sdk": "^0.5.0",
    "@bankofai/agent-wallet": "3.1.0-beta.1",
    "@bankofai/x402-tron": "2.1.2",
    "@hono/node-server": "^2.1.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "hono-rate-limiter": "0.5.4",
    "pg": "^8.13.0",
    "prom-client": "^15.1.0",
    "tronweb": "^6.5.1",
    "viem": "^2.21.0",
    "yaml": "^2.5.0",
    "zod": "4.6.7",
    "@bankofai/x402-tron-extensions": "2.1.2",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/extensions": "2.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.10",
    "eslint": "^10.8.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tronweb": {
      "axios": "1.21.1",
      "bignumber.js": "9.3.1",
      "eventemitter3": "5.0.4",
      "semver": "7.8.6",
      "tslib": "2.9.1",
      "validator": "13.15.35"
    },
    "follow-redirects": "^1.16.3",
    "ws": "^8.22.2",
    "esbuild": "^0.28.2",
    "zod": "$zod",
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "optionalDependencies": {
    "ioredis": "^6.0.0"
  }
}
