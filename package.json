{
  "name": "x402-facilitator",
  "version": "2.2.2",
  "description": "x402 Facilitator service (TypeScript, @bankofai/x402-* ecosystem)",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "SPONSORING_REQUIRE_POSTGRES=1 vitest run test/sponsoring-postgres.test.ts test/sponsoring-service-postgres.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:gateway": "npm run build && node --test test/gateway-integration.mjs"
  },
  "dependencies": {
    "@1password/sdk": "^0.3.1",
    "@bankofai/agent-wallet": "3.1.0-beta.1",
    "@bankofai/x402-tron": "2.1.0",
    "@hono/node-server": "^2.0.12",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "hono-rate-limiter": "0.5.3",
    "pg": "^8.13.0",
    "prom-client": "^15.1.0",
    "tronweb": "^6.4.0",
    "viem": "^2.21.0",
    "yaml": "^2.5.0",
    "zod": "4.6.6",
    "@bankofai/x402-tron-extensions": "2.1.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.10",
    "eslint": "^10.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tronweb": {
      "axios": "1.20.0"
    },
    "follow-redirects": "^1.16.1",
    "ws": "^8.21.1",
    "esbuild": "^0.28.1",
    "zod": "$zod"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.0"
  }
}
